FROM node:22-alpine AS builder

# Install pnpm and git
RUN apk add --no-cache git && npm install -g pnpm@12.3.4

WORKDIR /app

# Clone penpot repo and copy only mcp directory
RUN git clone --depth 1 --branch develop https://github.com/penpot/penpot.git /tmp/penpot && \
    cp -r /tmp/penpot/mcp/. . && rm -rf /tmp/penpot

# Install dependencies for all workspaces
RUN pnpm install

# Build all components
RUN pnpm run build

# Production stage
FROM node:22-alpine

WORKDIR /app/packages/server

# Copy built artifacts from builder
COPY --from=builder /app/packages/common/ ./../common/
COPY --from=builder /app/packages/server/ .
COPY --from=builder /app/node_modules/ ./../../node_modules/

# Expose MCP server ports: HTTP/SSE, WebSocket, REPL
EXPOSE 4401 4402 4403

# Run the MCP server (single-user mode by default)
CMD ["node", "dist/index.js"]