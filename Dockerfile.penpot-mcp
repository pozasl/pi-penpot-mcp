FROM node:22-alpine AS builder

WORKDIR /app

# Copy penpot-mcp source from build context
COPY penpot-mcp-src/. .

# Install dependencies for all workspaces
RUN npm install --prefix . && \
    npm run install:all

# Build all components (multi-user version)
RUN npm run build:all-multi-user

# Production stage
FROM node:22-alpine

WORKDIR /app

# Copy built artifacts from builder
COPY --from=builder /app/package.json ./
COPY --from=builder /app/common/ ./common/
COPY --from=builder /app/mcp-server/ ./mcp-server/
COPY --from=builder /app/penpot-plugin/dist/ ./plugin-dist/

# Install production dependencies only for mcp-server
RUN npm install --prefix mcp-server --omit=dev

# Expose MCP server ports: HTTP/SSE, WebSocket, REPL
EXPOSE 4401 4402 4403

# Run the MCP server (single-user mode by default)
CMD ["npm", "--prefix", "mcp-server", "run", "start"]
